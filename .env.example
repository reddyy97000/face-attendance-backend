# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# ── Database ──────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/face_attendance?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=changeme

# ── Server ────────────────────────────────────────────
PORT=8081

# ── CORS — comma-separated origins (NO wildcards!) ───
CORS_ORIGINS=https://your-frontend.example.com

# ── API Key — set a strong random value ──────────────
# Leave blank to disable (local dev only).
# Generate one: openssl rand -hex 32
API_KEY=

# ── Face Recognition ─────────────────────────────────
FACE_THRESHOLD=0.70

# ── Spring Profile ───────────────────────────────────
# Use "prod" for production deployments.
SPRING_PROFILES_ACTIVE=prod

# ── Schema (first deploy only) ───────────────────────
# Set to "update" for the very first deployment to create tables,
# then remove or set to "validate".
# DDL_AUTO=update
